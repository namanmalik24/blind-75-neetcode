class Solution {
public:
    void dfs(int i, int j, vector<vector<char>>& grid,
             vector<vector<int>>& vis) {

        vis[i][j] = 1;

        int n = grid.size();
        int m = grid[0].size();

        int drow[] = {-1, 0, 1, 0};
        int dcol[] = {0, 1, 0, -1};

        for (int k = 0; k < 4; k++) {
            int ni = i + drow[k];
            int nj = j + dcol[k];

            if (ni >= 0 && ni < n && nj >= 0 && nj < m &&
                vis[ni][nj] == 0 && grid[ni][nj] == '1') {
                dfs(ni, nj, grid, vis);
            }
        }
    }

    int numIslands(vector<vector<char>>& grid) {
        int n = grid.size();
        int m = grid[0].size();

        vector<vector<int>> vis(n, vector<int>(m, 0));
        int count = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (vis[i][j] == 0 && grid[i][j] == '1') {
                    dfs(i, j, grid, vis);
                    count++;
                }
            }
        }

        return count;
    }
};