class Solution {
public:
    bool checking(string s) {
        int i = 0, j = s.size() - 1;

        while (i <= j) {
            if (s[i] != s[j]) return false;
            i++;
            j--;
        }
        return true;
    }

    bool isPalindrome(string s) {
        string clean = "";

        for(auto it: s)
        {
            if(isalnum(it))
            {
                clean =  clean + (char)tolower(it);
            }
        }

        return checking(clean);
    }
};