class Solution {
public:
    void solve(int n, vector<string>& ans, string s) {

        if (s.length() == n) {
            ans.push_back(s);
            return;
        }

        solve(n, ans, s + '1');

        if (s.length()==0 || s.back() == '1') {
            solve(n, ans, s + '0');
        }
    }

    vector<string> validStrings(int n) {
        vector<string> ans;
        string s = "";
        solve(n, ans, s);
        return ans;
    }
};