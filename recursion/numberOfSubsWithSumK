class Solution{
    public:   
    int fun(int i, vector<int>&nums, int k){
        if(k==0) return 1;

        if(k<0 || i==nums.size())
        {
            return 0;
        }
        
        int not_take= fun(i+1,nums,k);
        int take=0;

        if(nums[i]<=k)
        {
            take=fun(i+1, nums, k-nums[i]);
        }

        return take + not_take;
    } 	
    int countSubsequenceWithTargetSum(vector<int>& nums, int k){
    	//your code goes here
        return fun(0,nums,k);
    }
};