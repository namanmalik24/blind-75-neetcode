class Solution {
public:
    int lengthOfLongestSubstring(string s) {

        if (s.size() == 0) {
            return 0;
        }

        unordered_set<char> st;
        int l = 0, r = 0;
        int maxLen = 0;

        while (r < s.size()) {
            if (st.find(s[r]) == st.end()) {
                st.insert(s[r]);
                r++;
                maxLen = max(maxLen, r - l);  
            } else {
                st.erase(s[l]);
                l++;
            }
        }

        return maxLen;
    }
};