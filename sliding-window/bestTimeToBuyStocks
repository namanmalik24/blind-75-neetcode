class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int max_profit = 0;
        int n = prices.size();
        int t = prices[0];

        for (int i = 1; i < n; i++) {
            if (prices[i] < t) {

                t = prices[i];
            } else {
                max_profit = max(max_profit, prices[i] - t);
            }
        }

        return max_profit;
    }
};