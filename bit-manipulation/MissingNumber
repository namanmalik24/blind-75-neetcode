class Solution {
public:
    int missingNumber(vector<int>& nums) {

        int n = nums.size()+1;
        int sum= (n*(n-1))/2;
        int fake=0;

        for(int i=0;i<n-1;i++){
            fake=fake+nums[i];
        }

        return sum-fake;
        
    }
};

//this is not the bit solution though

class Solution {
public:
    int missingNumber(vector<int>& nums) {

        int result = nums.size();
        for (int i = 0; i < nums.size(); i++) {
            result ^= i ^ nums[i];
        }

        return result;
    }
};