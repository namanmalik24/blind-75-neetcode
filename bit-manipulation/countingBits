class Solution {
public:
    int numberOfOnes(int n) {
        int cnt = 0;
        while (n > 0) {
            if (n & 1 == 1) {
                cnt++;
            }
            n = n >> 1;
        }
        return cnt;
    }
    vector<int> countBits(int n) {
         vector<int> ans; 
         for(int i=0;i<n+1;i++)
         {
            ans.push_back(numberOfOnes(i));
         }

         return ans;

    }
};

//dp solution

class Solution {
public:
    vector<int> countBits(int n) {
        vector<int> res(n+1);
        for(int i=1;i<=n; i++){
            res[i] = res[i/2] + (i%2);
        }
        return res;
    }
};